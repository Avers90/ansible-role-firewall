#!/usr/bin/env bash
## {{ ansible_managed }}

IPT="iptables"

## Network configuration
WAN={{ firewall_wan_interface_actual }}
WAN_IP={{ firewall_wan_ip_actual }}

## Port lists
WPORT_TCP={{ firewall_public_ports_tcp | join(',') }}
{% if firewall_public_ports_udp | length > 0 %}
WPORT_UDP={{ firewall_public_ports_udp | join(',') }}
{% endif %}

## Create ipset lists if not exist
ipset list WHITELIST >/dev/null 2>&1 || ipset create WHITELIST hash:net

## Populate whitelist
ipset flush WHITELIST
{% for ip in firewall_whitelist_combined %}
ipset add WHITELIST {{ ip }} -exist
{% endfor %}

## Clear all iptables rules
$IPT -F
$IPT -F -t nat
$IPT -F -t mangle
$IPT -X 2>/dev/null
$IPT -t nat -X 2>/dev/null
$IPT -t mangle -X 2>/dev/null

## Ban lists of older role versions (no rule references them after the flush)
ipset destroy BANPORT 2>/dev/null
ipset destroy BANDDOS 2>/dev/null

## Default policies: DROP everything
$IPT -P INPUT DROP
$IPT -P OUTPUT DROP
$IPT -P FORWARD DROP

## Allow established connections
$IPT -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
$IPT -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
$IPT -A FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

## Allow localhost
$IPT -A INPUT -i lo -j ACCEPT
$IPT -A OUTPUT -o lo -j ACCEPT

{% if firewall_allow_ping %}
## Allow ICMP (ping)
$IPT -A INPUT -p icmp --icmp-type echo-reply -j ACCEPT
$IPT -A INPUT -p icmp --icmp-type destination-unreachable -j ACCEPT
$IPT -A INPUT -p icmp --icmp-type time-exceeded -j ACCEPT
$IPT -A INPUT -p icmp --icmp-type echo-request -j ACCEPT
{% endif %}

## Whitelist IPs (full access, never banned)
$IPT -A INPUT -m set --match-set WHITELIST src -j ACCEPT

## Allow all outgoing connections
$IPT -A OUTPUT -o ${WAN} -j ACCEPT

## Drop invalid packets
$IPT -A INPUT -m state --state INVALID -j DROP
$IPT -A FORWARD -m state --state INVALID -j DROP

## Drop null packets
$IPT -A INPUT -p tcp --tcp-flags ALL NONE -j DROP

## Syn-flood protection
$IPT -A INPUT -p tcp ! --syn -m state --state NEW -j DROP
$IPT -A OUTPUT -p tcp ! --syn -m state --state NEW -j DROP

{% if firewall_ssh_ratelimit | length > 0 %}
## SSH: drop NEW connections above the per-source-IP rate. No ban list — the
## source gets through again as soon as it slows down. Sits after the WHITELIST
## ACCEPT, so whitelisted IPs never hit it, and covers the SSH port only, so a
## bot behind a shared CGNAT IP cannot affect VPN / web users on that IP.
$IPT -A INPUT -i ${WAN} -p tcp --dport {{ firewall_ssh_port }} -m conntrack --ctstate NEW -m hashlimit --hashlimit-above {{ firewall_ssh_ratelimit }} --hashlimit-burst {{ firewall_ssh_burst }} --hashlimit-mode srcip --hashlimit-name ssh --hashlimit-htable-expire 600000 -j DROP
{% endif %}

## --- Service ports ---
## Everything not accepted below hits the INPUT DROP policy.
{% if firewall_wireguard_enabled %}
## WireGuard
$IPT -A INPUT -i ${WAN} -p udp --dport {{ firewall_wireguard_port_udp }} -j ACCEPT
$IPT -A INPUT -i {{ firewall_wireguard_interface }} -j ACCEPT
$IPT -A OUTPUT -o {{ firewall_wireguard_interface }} -j ACCEPT
$IPT -A FORWARD -i {{ firewall_wireguard_interface }} -j ACCEPT
$IPT -A FORWARD -o {{ firewall_wireguard_interface }} -j ACCEPT
{% if firewall_wireguard_snat_source | length > 0 %}
$IPT -t nat -A POSTROUTING -s {{ firewall_wireguard_network }} -o ${WAN} -j SNAT --to-source {{ firewall_wireguard_snat_source }}
{% else %}
$IPT -t nat -A POSTROUTING -s {{ firewall_wireguard_network }} -o ${WAN} -j MASQUERADE
{% endif %}
{% for port in firewall_wireguard_extra_ports_udp if port | int != firewall_wireguard_port_udp | int %}
## Extra entry port {{ port }}/udp -> {{ firewall_wireguard_port_udp }} (filter INPUT sees the rewritten port)
$IPT -t nat -A PREROUTING -i ${WAN} -p udp --dport {{ port }} -j REDIRECT --to-ports {{ firewall_wireguard_port_udp }}
{% endfor %}
{% if firewall_wireguard_mss | int > 0 %}
## TCP MSS clamp (both directions, lower-only: tcpmss match skips SYNs already <= MSS)
$IPT -t mangle -A FORWARD -o {{ firewall_wireguard_interface }} -p tcp --tcp-flags SYN,RST SYN -m tcpmss --mss {{ firewall_wireguard_mss | int + 1 }}:65535 -j TCPMSS --set-mss {{ firewall_wireguard_mss | int }}
$IPT -t mangle -A FORWARD -i {{ firewall_wireguard_interface }} -p tcp --tcp-flags SYN,RST SYN -m tcpmss --mss {{ firewall_wireguard_mss | int + 1 }}:65535 -j TCPMSS --set-mss {{ firewall_wireguard_mss | int }}
{% endif %}
{% endif %}

{% if firewall_restricted_ports_tcp | length > 0 %}
## Restricted TCP ports — open only to specific source IPs
{% for rule in firewall_restricted_ports_tcp %}
{% for src in rule.sources %}
$IPT -A INPUT -i ${WAN} -p tcp --dport {{ rule.port }} -s {{ src }} -j ACCEPT
{% endfor %}
{% endfor %}
{% endif %}

## Allow TCP ports
$IPT -A INPUT -i ${WAN} -p tcp -m multiport --dports ${WPORT_TCP} -j ACCEPT

{% if firewall_public_ports_udp | length > 0 %}
## Allow UDP ports
$IPT -A INPUT -i ${WAN} -p udp -m multiport --dports ${WPORT_UDP} -j ACCEPT
{% endif %}

{% for rule in firewall_custom_rules %}
{{ rule }}
{% endfor %}

{% if firewall_ipv6_block %}
## --- IPv6: inbound closed, outbound open ---
## None of the rules above apply to IPv6, so without this a host with a public
## v6 address exposes every listener (incl. [::]:51820) with no whitelist, bans
## or rate limits. Only replies, loopback and ICMPv6 get in: ICMPv6 carries
## Neighbor Discovery / Router Advertisements and Packet Too Big — dropping it
## breaks v6 outright. DHCPv6 replies come from link-local, not tracked by conntrack.
if command -v ip6tables >/dev/null 2>&1; then
  IP6T="ip6tables"
  $IP6T -F
  $IP6T -X 2>/dev/null
  $IP6T -P INPUT DROP
  $IP6T -P FORWARD DROP
  $IP6T -P OUTPUT ACCEPT
  $IP6T -A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  $IP6T -A INPUT -i lo -j ACCEPT
  $IP6T -A INPUT -p ipv6-icmp -j ACCEPT
  $IP6T -A INPUT -s fe80::/10 -p udp --dport 546 -j ACCEPT
{% if firewall_wireguard_enabled and firewall_ipv6_allow_wireguard %}
  ## WireGuard/AWG entry over IPv6 (outer transport only; the tunnel stays IPv4)
  $IP6T -t nat -F
  $IP6T -A INPUT -i ${WAN} -p udp --dport {{ firewall_wireguard_port_udp }} -j ACCEPT
{% for port in firewall_wireguard_extra_ports_udp if port | int != firewall_wireguard_port_udp | int %}
  $IP6T -t nat -A PREROUTING -i ${WAN} -p udp --dport {{ port }} -j REDIRECT --to-ports {{ firewall_wireguard_port_udp }}
{% endfor %}
{% endif %}
fi
{% endif %}

echo "Firewall rules applied successfully"
